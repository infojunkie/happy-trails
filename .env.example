# Database connection
# Either a full URL...
# DATABASE_URL=postgres://user:password@localhost:5432/mediaserver
# ...or standard libpq variables (pg also honours ~/.pgpass):
PGHOST=localhost
PGPORT=5432
PGDATABASE=mediaserver
PGUSER=postgres
# PGPASSWORD=...

# HTTP server
HOST=127.0.0.1
PORT=3000
# When the app sits behind a trusted reverse proxy, set this to the proxy's
# address/CIDR (or "loopback" / a hop count) so req.ip is the real client for
# login rate limiting and req.secure is correct. Leave unset for direct access.
# TRUST_PROXY=loopback

# Failed sign-ins allowed per client IP and per account, per window. Further
# attempts receive 429 with Retry-After. A successful sign-in clears the
# account's failure count; DSM outages do not count as failures.
# LOGIN_RATE_LIMIT_MAX=20
# LOGIN_ACCOUNT_LIMIT_MAX=5
# LOGIN_RATE_LIMIT_WINDOW_MS=900000

# Tables to read (schema/table must be plain SQL identifiers)
MUSIC_SCHEMA=public
MUSIC_TABLE=music
# Used to map a music path to the AudioStation cover id
TRACK_TABLE=track

# Synology DSM (optional).
# DSM_URL is required for user sign-in, covers, and Artwork.pdf lookups. The
# workspace-level ../.env is loaded as a fallback, so DSADDR works too.
# DSM_USER / DSM_PASS are an optional service account used for album covers and
# Artwork.pdf lookups (it needs read access to the music share); users sign in
# with their own DSM account in the web app.
# DSM_URL=https://nas.local:5001
# DSM_USER=api
# DSM_PASS=...
# DSM_FRONTEND_URL is used to redirect the playback button to the Synology
# frontend. A full http(s) URL is used verbatim; if unset, DSM_URL/DSADDR is
# used instead. Otherwise use ":port" to keep the host the browser used and
# change only the port, for example:
#   :5001         same host and scheme, port 5001, root path
# Path rewriting is not supported. With ":port", the browser host must match
# one of DSM_FRONTEND_ALLOWED_ORIGINS, so the redirect can never leave the
# configured origins. List every origin the app is served from, without paths:
#   DSM_FRONTEND_URL=:443
#   DSM_FRONTEND_ALLOWED_ORIGINS=https://mediatheque.example:8443,https://nas-local:8443
# The request Host (or X-Forwarded-Host when a reverse proxy rewrites Host) is
# matched against this list; Origin and Referer are never used.
# DSM_FRONTEND_URL=
# DSM_FRONTEND_ALLOWED_ORIGINS=
DSM_TLS_REJECT_UNAUTHORIZED=false
DSM_TIMEOUT_MS=10000
COVER_CACHE_TTL_MS=86400000
COVER_CACHE_ENTRIES=500

# Extra words that separate multiple artists in the artist/album_artist
# columns. These are added to the defaults: feat., com, part., avec, with, et,
# e, con, vs., mit. Punctuation (e.g. " / ") is a separator when surrounded by
# spaces; a comma followed by whitespace also separates names ("A, B, C").
# An ampersand splits only when both sides have multiple words, so
# "Stan Getz & João Gilberto" splits while "Simon & Garfunkel" does not.
# ARTIST_SEPARATOR_WORDS=ft.,featuring,vs.,y

# Artist names that must stay intact even though they contain separators, such
# as "Earth, Wind & Fire" or "Florence + The Machine". These are added to the
# defaults (which include those two plus Simon & Garfunkel and
# Crosby, Stills, Nash & Young). Separate entries with "|", because the names
# themselves contain commas.
# ARTIST_EXCEPTIONS=Hall & Oates|Tyler, The Creator

# Extra genre tags to classify as countries/regions. ISO country names,
# macro-regions, and common subnational regions are detected automatically;
# use this list for site-specific names or spelling variants, separated by "|".
# REGION_TAGS=Corsica|Catalonia|Occitania

# Series/label names that should not be indexed, such as "Legacy" from
# "[2016 Legacy Edition]" or "Collector's" from "[2016 Collector's Edition]".
# Added to the defaults ("Legacy", "Collector's"), separated by "|"; matching
# ignores case, accents, and apostrophes.
# SERIES_EXCEPTIONS=Deluxe|Expanded

# How often to check the music table for changes (ms). A detected change
# triggers a silent snapshot rebuild; open pages get a Refresh indicator.
LIBRARY_CHECK_MS=60000

# Pagination and query safety
PAGE_SIZE=48
MAX_PAGE_SIZE=200
DB_STATEMENT_TIMEOUT_MS=30000
